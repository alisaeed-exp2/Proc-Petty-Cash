# PostgreSQL (use letters and digits only in the password)
DATABASE_URL="postgresql://akcc:DB_PASSWORD@127.0.0.1:5432/akcc"
DIRECT_URL="postgresql://akcc:DB_PASSWORD@127.0.0.1:5432/akcc"

# Login secret. Generate with: openssl rand -base64 32
# Never change it later: keys saved in System settings are encrypted with it.
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Public address of the app (used in email links; can also be set in System settings)
APP_URL="http://localhost:3000"

# First administrator, created once by: node scripts/bootstrap.cjs
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Your Name"
ADMIN_INITIAL_PASSWORD="ChangeMe12345"

# File storage, Anthropic key and email are normally set in the app under System settings.
# These variables are only a fallback when nothing is saved there:
# STORAGE_MODE="local"            # or "s3"
# STORAGE_LOCAL_PATH="/var/lib/akcc/files"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# ANTHROPIC_API_KEY=""
# RESEND_API_KEY=""
# EMAIL_FROM=""
